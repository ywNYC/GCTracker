# Cloudflare Pages Functions env vars (set via dashboard or `wrangler pages secret put`).
# None of these are read at build time — copy this file to .env only for local
# `scripts/render-monthly-preview.mjs` runs; production values live in Cloudflare, not here.

# Bearer-token auth for all /api/admin/* endpoints (subscribers export, send-monthly,
# analytics, email-stats, confirm-subscriber, delete-subscriber, preview-monthly).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Resend (https://resend.com) API key used to send subscriber emails.
RESEND_API_KEY=

# "From" address for outbound email, e.g. "GC Tracker <updates@gc.jmjvc.us>".
RESEND_FROM=

# Svix HMAC secret validating inbound POST /api/webhooks/resend requests.
# Fails open (verified:false) rather than reject when unset.
RESEND_WEBHOOK_SECRET=

# HMAC key for signed confirm/unsubscribe tokens. Keep separate from the other secrets.
UNSUBSCRIBE_SECRET=

# Base URL the admin functions self-fetch static JSON from. Defaults to
# https://gc.jmjvc.us if unset.
SITE_URL=

# SUBSCRIBERS is a Cloudflare KV namespace binding, not a string var — configure it
# as a KV binding in the Pages dashboard (or wrangler.toml if one is ever added), not here.

# --- Local-only vars for scripts/render-monthly-preview.mjs ---
# Recipient address for a local test send.
PREVIEW_TO=
# Synthetic test-case parameters (defaults shown).
PREVIEW_CAT=F4
PREVIEW_COUNTRY=China
PREVIEW_PD=2015-06-01
PREVIEW_LANG=zh
